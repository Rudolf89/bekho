includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Larastan lee los `casts()` del cuerpo del método (no solo su @return),
    # para que los enums y las fechas casteadas se tipen de verdad.
    parseModelCastsMethod: true
